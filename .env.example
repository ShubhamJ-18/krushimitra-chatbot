# ==============================================================================
# KrushiMitra AI — Configuration File
# Copy this file to .env and configure your keys
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development

# LLM Providers Configuration (Supports Groq, Google Gemini, OpenAI, or local Ollama)
DEFAULT_AI_PROVIDER=groq

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b,llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Alternative Providers (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Database Configuration (SQLite default)
DATABASE_URL=sqlite:///./data/krushimitra.db

# Weather Service Configuration
WEATHER_API_PROVIDER=open-meteo
WEATHER_CACHE_MINUTES=30

# Mandi Market Price Service Configuration
MANDI_CACHE_HOURS=6

# Default Regional Context
DEFAULT_REGION=Maharashtra
DEFAULT_LANGUAGE=English
