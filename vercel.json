{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "main.py": {
      "includeFiles": "{Chatbot.html,Chatbot(1).html,static/**,data/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/main.py?__path__=/api/$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "/main.py?__path__=/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/main.py"
    }
  ]
}

